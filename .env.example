# app
NODE_ENV=production
PORT=3000
ADMIN_PORT=3000
# ADMIN_PORT=3001
# incase of docker both ADMIN_PORT and PORT will be 3000

# docker url (as all services in same docker network)
DATABASE_URL="postgresql://admin:admin@postgres:5432/desi_connect?schema=public"
# without docker
# DATABASE_URL="postgresql://admin:admin@localhost:5432/desi_connect?schema=public"

# postgres
PG_ADMIN_EMAIL=admin@admin.com
PG_ADMIN_PASSWORD=admin
PG_USER=admin
PG_PW=admin
PG_DB=desilynks

# json web tokens
JWT_SECRET=strong-sec
JWT_SECRET_EXPIRY=30m
ADMIN_JWT_SECRET=strong-sec-admin
ADMIN_JWT_SECRET_EXPIRY=30m
ADMIN_SEED_SECRET=strong-key

# redis
REDIS_PASSWORD=strong-password
# incase docker
REDIS_PORT=6379
REDIS_HOST=redis
# without docker
# REDIS_HOST=localhost
# REDIS_PORT=6378


# mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=youremail
MAIL_PASSWORD=your-app-password
MAIL_FROM="DesiLynks <Your email>"

# social login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.yourapp.bundleid

# elasticsearch cluster (docker-compose.elasticsearch.yml)
ELASTIC_SECURITY_ENABLED=true
ELASTIC_PASSWORD=strong-password
KIBANA_PASSWORD=kibana-local-password
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# elasticsearch application user (created by docker-compose.elasticsearch.yml)
# if the app runs in docker:
ELASTICSEARCH_NODES=http://es01:9200,http://es02:9200
# if without docker
# ELASTICSEARCH_NODES="http://localhost:9200,http://localhost:9201"
ELASTICSEARCH_USERNAME=desiconnect_app
ELASTICSEARCH_PASSWORD=strong-password
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_SNIFF_ON_START=false

# firebase setup
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/desilynks-chat-firebase.json